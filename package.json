{
  "name": "needleworks",
  "version": "1.0.0",
  "description": "Needle Works: Haystack Industries — a 2D factory automation game about finding needles in haystacks. Static site, deployable to GitHub Pages.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx --yes http-server . -p 8080 -c-1",
    "serve": "python3 -m http.server 8080",
    "test:sim": "node tests/sim.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test": "node tests/sim.test.mjs && node tests/e2e.test.mjs",
    "build": "node tools/build.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0"
  },
  "license": "MIT"
}
